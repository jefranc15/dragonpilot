def manager_values(manager_state):
  running = []
  not_running = []

  try:
    for process in get_path(manager_state, "processes", []):
      name = as_text(get_path(process, "name", ""))
      should_run = as_bool(
        get_path(process, "shouldBeRunning", False))
      is_running = as_bool(get_path(process, "running", False))

      if should_run and is_running:
        running.append(name)
      elif should_run and not is_running:
        not_running.append(name)
  except Exception:
    pass

  return {
    "managerExpectedRunning": "|".join(running),
    "managerExpectedButStopped": "|".join(not_running),
  }


def device_values(device_state):
  cpu_values = []
  try:
    cpu_values = [
      float(value)
      for value in get_path(device_state, "cpuUsagePercent", [])
    ]
  except Exception:
    pass

  return {
    "freeSpacePercent": as_float(
      get_path(device_state, "freeSpacePercent", float("nan"))),
    "memoryUsagePercent": as_float(
      get_path(device_state, "memoryUsagePercent", float("nan"))),
    "cpuUsageAvg":
      sum(cpu_values) / len(cpu_values) if cpu_values else float("nan"),
    "cpuUsageMax":
      max(cpu_values) if cpu_values else float("nan"),
    "thermalStatus": as_text(
      get_path(device_state, "thermalStatus", "")),
    "networkType": as_text(
      get_path(device_state, "networkType", "")),
  }


