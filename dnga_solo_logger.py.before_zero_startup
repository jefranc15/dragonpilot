def main():
  signal.signal(signal.SIGINT, request_stop)
  signal.signal(signal.SIGTERM, request_stop)

  os.chdir(BASE)

  services = available_services()
  sm = messaging.SubMaster(services)

  can_sock = open_socket("can")
  sendcan_sock = open_socket("sendcan")

  stamp = datetime.now().strftime("%m%d_%H%M%S")

  summary_path = (
    BASE + "/dnga_solo_summary_" + stamp + ".csv.gz")
  selected_path = (
    BASE + "/dnga_solo_selected_can_" + stamp + ".csv.gz")
  raw_path = (
    BASE + "/dnga_solo_raw_events_" + stamp + ".csv.gz")
  events_path = (
    BASE + "/dnga_solo_events_" + stamp + ".csv")

  print("DNGA solo mapping logger %s" % VERSION)
  print("Passive/read-only. It does not transmit CAN.")
  print("No vehicle code is modified.")
  print("")
  print("FIRST 90 SECONDS: remain parked and follow the phase shown.")
  print("During each button phase, press and release that button 3 times.")
  print("After PREPARE_TO_DRIVE changes to DRIVE, close SSH and drive.")
  print("")
  print("Summary:", summary_path)
  print("Selected CAN:", selected_path)
  print("Raw events:", raw_path)
  print("Events:", events_path)

  start_ns = time.monotonic_ns()
  start_seconds = start_ns / 1e9
  next_sample = time.monotonic()
  last_loop = next_sample
  last_status = next_sample

  rx_cache = {}
  tx_cache = {}
  prebuffer = deque(maxlen=MAX_PREBUFFER_FRAMES)

  summary_rows = 0
  raw_sequence = 0
  selected_sequence = 0
  raw_written = 0
  selected_written = 0

  event_id = 0
  event_active = False
  event_start_t = 0.0
  event_end_monotonic = 0.0
  event_reasons = []
  event_raw_start = 0
  cooldown_until = 0.0

  previous_values = {}
  previous_a_ego = None
  previous_a_time = None

  with gzip.open(
      summary_path, "wt", compresslevel=1, newline="") as summary_file, \
       gzip.open(
      selected_path, "wt", compresslevel=1, newline="") as selected_file, \
       gzip.open(
      raw_path, "wt", compresslevel=1, newline="") as raw_file, \
       open(events_path, "w", newline="") as events_file:

    summary_writer = csv.DictWriter(
      summary_file,
      fieldnames=SUMMARY_FIELDS,
      extrasaction="ignore",
    )
    selected_writer = csv.DictWriter(
      selected_file,
      fieldnames=SELECTED_FIELDS,
      extrasaction="ignore",
    )
    raw_writer = csv.DictWriter(
      raw_file,
      fieldnames=RAW_FIELDS,
      extrasaction="ignore",
    )
    events_writer = csv.DictWriter(
      events_file,
      fieldnames=EVENT_FIELDS,
      extrasaction="ignore",
    )

    summary_writer.writeheader()
    selected_writer.writeheader()
    raw_writer.writeheader()
    events_writer.writeheader()

    while not STOP_REQUESTED:
      loop_now = time.monotonic()
      t = loop_now - start_seconds
      phase = startup_phase(t)
      phase_remaining = startup_phase_remaining(t)
      loop_dt_ms = (loop_now - last_loop) * 1000.0
      last_loop = loop_now

      try:
        sm.update(0)
      except TypeError:
        sm.update()

      rx_frames = drain_socket(
        can_sock, "can", "rx", start_ns, rx_cache)
      tx_frames = drain_socket(
        sendcan_sock, "sendcan", "tx", start_ns, tx_cache)
      new_frames = rx_frames + tx_frames

      # Continuously record only the selected CAN IDs.
      for frame in new_frames:
        if frame["address"] in WATCH_IDS:
          selected_sequence += 1
          write_selected(
            selected_writer,
            frame,
            phase,
            selected_sequence,
          )
          selected_written += 1

      car_state = sm_get(sm, "carState")
      car_control = sm_get(sm, "carControl")
      controls = sm_get(sm, "controlsState")
      radar = sm_get(sm, "radarState")
      plan = sm_get(sm, "longitudinalPlan")
      live = sm_get(sm, "liveParameters")
      device_state = sm_get(sm, "deviceState")
      manager_state = sm_get(sm, "managerState")

      cruise = get_path(car_state, "cruiseState", None)
      actuators = get_path(car_control, "actuators", None)

      v_ego = as_float(get_path(car_state, "vEgo", 0.0), 0.0)
      a_ego = as_float(
        get_path(car_state, "aEgo", float("nan")))
      gas = as_float(
        get_path(car_state, "gas", float("nan")))
      gas_pressed = as_bool(
        get_path(car_state, "gasPressed", False))
      brake_pressed = as_bool(
        get_path(car_state, "brakePressed", False))
      brake_lights = as_bool(
        get_path(car_state, "brakeLights", False))
      standstill = as_bool(
        get_path(car_state, "standstill", False))

      cruise_available = as_bool(
        get_path(cruise, "available", False))
      cruise_enabled = as_bool(
        get_path(cruise, "enabled", False))
      cruise_standstill = as_bool(
        get_path(cruise, "standstill", False))
      cruise_speed = as_float(
        get_path(cruise, "speed", float("nan")))

      rx271 = decode_271(
        latest_address(rx_cache, 0x271), "rx")
      rx271_active = as_bool(
        rx271.get("rx271Active", False))
      rx271_state = as_text(
        rx271.get("rx271StateName", ""))

      buttons = button_events(car_state)

      current_values = {
        "brakePressed": brake_pressed,
        "gasPressed": gas_pressed,
        "cruiseAvailable": cruise_available,
        "cruiseEnabled": cruise_enabled,
        "cruiseStandstill": cruise_standstill,
        "standstill": standstill,
        "rx271Active": rx271_active,
      }

      trigger_reasons = []

      if t >= STARTUP_CAPTURE_SECONDS:
        # Rising edges and state transitions only. Sustained braking does not
        # keep extending a raw event window.
        for name, value in current_values.items():
          if name in previous_values and value != previous_values[name]:
            add_reason(
              trigger_reasons,
              "%s:%s>%s" % (
                name,
                previous_values[name],
                value,
              ),
            )

        if buttons:
          add_reason(trigger_reasons, "buttonEvent")

        if a_ego == a_ego:
          previous_strong_accel = as_bool(
            previous_values.get("strongAccel", False))
          previous_strong_decel = as_bool(
            previous_values.get("strongDecel", False))

          strong_accel = a_ego >= 0.75
          strong_decel = a_ego <= -0.75

          if strong_accel and not previous_strong_accel:
            add_reason(trigger_reasons, "strongAccel")
          if strong_decel and not previous_strong_decel:
            add_reason(trigger_reasons, "strongDecel")

          current_values["strongAccel"] = strong_accel
          current_values["strongDecel"] = strong_decel

      # Startup captures every CAN ID for 90 seconds.
      startup_full_capture = t < STARTUP_CAPTURE_SECONDS

      # Start a bounded event only after startup and cooldown.
      if (
          not startup_full_capture and
          not event_active and
          trigger_reasons and
          loop_now >= cooldown_until
      ):
        event_id += 1
        event_active = True
        event_start_t = t
        event_end_monotonic = loop_now + POST_EVENT_SECONDS
        event_reasons = list(trigger_reasons)
        event_raw_start = raw_written

        reason_text = "|".join(event_reasons)

        for frame in prebuffer:
          raw_sequence += 1
          write_raw(
            raw_writer,
            frame,
            phase,
            event_id,
            reason_text,
            raw_sequence,
          )
          raw_written += 1
        prebuffer.clear()

      elif event_active and trigger_reasons:
        for reason in trigger_reasons:
          add_reason(event_reasons, reason)

      if startup_full_capture:
        # Startup is event 0 and is labeled by the timed button phase.
        for frame in new_frames:
          raw_sequence += 1
          write_raw(
            raw_writer,
            frame,
            phase,
            0,
            "startup_button_mapping",
            raw_sequence,
          )
          raw_written += 1

      elif event_active:
        reason_text = "|".join(event_reasons)
        for frame in new_frames:
          raw_sequence += 1
          write_raw(
            raw_writer,
            frame,
            phase,
            event_id,
            reason_text,
            raw_sequence,
          )
          raw_written += 1

        if loop_now >= event_end_monotonic:
          events_writer.writerow({
            "eventId": event_id,
            "eventStartT": event_start_t,
            "eventEndT": t,
            "eventReasons": reason_text,
            "rawFramesAtStart": event_raw_start,
            "rawFramesAtEnd": raw_written,
          })
          events_file.flush()

          event_active = False
          cooldown_until = loop_now + EVENT_COOLDOWN_SECONDS
          event_reasons = []

      else:
        for frame in new_frames:
          prebuffer.append(frame)

        # Keep only approximately the requested pre-event time.
        cutoff = t - PRE_EVENT_SECONDS
        while prebuffer and prebuffer[0]["t"] < cutoff:
          prebuffer.popleft()

      estimated_jerk = float("nan")
      if (
          previous_a_ego is not None and
          previous_a_time is not None and
          a_ego == a_ego
      ):
        dt = loop_now - previous_a_time
        if dt > 0.001:
          estimated_jerk = (a_ego - previous_a_ego) / dt

      if a_ego == a_ego:
        previous_a_ego = a_ego
        previous_a_time = loop_now

      car_control_active = as_bool(
        get_path(car_control, "active", False))
      controls_active = as_bool(
        get_path(controls, "active", False))
      act_accel = as_float(
        get_path(actuators, "accel", float("nan")))

      op_long_unexpected = (
        car_control_active or
        controls_active or
        (act_accel == act_accel and abs(act_accel) > 0.05)
      )

      row = {
        "t": t,
        "wallTime": datetime.now().isoformat(),
        "row": summary_rows,
        "loggerVersion": VERSION,
        "startupPhase": phase,
        "phaseRemainingSec": phase_remaining,

        "eventWindow":
          startup_full_capture or event_active,
        "eventId":
          0 if startup_full_capture else (
            event_id if event_active else ""),
        "eventReasons":
          "startup_button_mapping" if startup_full_capture else (
            "|".join(event_reasons) if event_active else ""),

        "rawFramesWritten": raw_written,
        "selectedFramesWritten": selected_written,
        "rxFramesThisCycle": len(rx_frames),
        "txFramesThisCycle": len(tx_frames),
        "loopDtMs": loop_dt_ms,

        "carStateAlive": sm_alive(sm, "carState"),
        "carControlAlive": sm_alive(sm, "carControl"),
        "controlsStateAlive": sm_alive(sm, "controlsState"),
        "radarStateAlive": sm_alive(sm, "radarState"),
        "longitudinalPlanAlive":
          sm_alive(sm, "longitudinalPlan"),
        "deviceStateAlive": sm_alive(sm, "deviceState"),
        "managerStateAlive": sm_alive(sm, "managerState"),

        "vEgo": v_ego,
        "vEgoKph": v_ego * 3.6,
        "vEgoRaw": as_float(
          get_path(car_state, "vEgoRaw", float("nan"))),
        "aEgo": a_ego,
        "estimatedJerk": estimated_jerk,
        "standstill": standstill,
        "gearShifter": as_text(
          get_path(car_state, "gearShifter", "")),

        "engineRpm": as_float(first_value(
          car_state,
          ["engineRpm", "engineRPM", "rpm"],
          float("nan"),
        )),
        "engineSpeedRpm": as_float(first_value(
          car_state,
          ["engineSpeedRpm", "engineSpeed"],
          float("nan"),
        )),
        "motorRpm": as_float(first_value(
          car_state,
          ["motorRpm", "tractionMotorRpm"],
          float("nan"),
        )),
        "transmissionRpm": as_float(first_value(
          car_state,
          ["transmissionRpm", "inputShaftRpm"],
          float("nan"),
        )),

        "gas": gas,
        "gasPressed": gas_pressed,
        "brake": as_float(
          get_path(car_state, "brake", float("nan"))),
        "brakePressed": brake_pressed,
        "brakeLights": brake_lights,

        "cruiseAvailable": cruise_available,
        "cruiseEnabled": cruise_enabled,
        "cruiseStandstill": cruise_standstill,
        "cruiseSpeedKph": cruise_speed * 3.6,

        "buttonEventsJson": json.dumps(
          buttons, separators=(",", ":")),

        "carControlEnabled": as_bool(
          get_path(car_control, "enabled", False)),
        "carControlActive": car_control_active,
        "controlsEnabled": as_bool(
          get_path(controls, "enabled", False)),
        "controlsActive": controls_active,
        "actAccel": act_accel,
        "actGas": as_float(
          get_path(actuators, "gas", float("nan"))),
        "actBrake": as_float(
          get_path(actuators, "brake", float("nan"))),
        "actSpeed": as_float(
          get_path(actuators, "speed", float("nan"))),
        "controlsATarget": as_float(
          get_path(controls, "aTarget", float("nan"))),
        "longControlState": as_text(
          get_path(controls, "longControlState", "")),

        "steeringAngleDeg": as_float(
          get_path(
            car_state, "steeringAngleDeg", float("nan"))),
        "steeringRateDeg": as_float(
          get_path(
            car_state, "steeringRateDeg", float("nan"))),
        "steeringTorque": as_float(
          get_path(
            car_state, "steeringTorque", float("nan"))),
        "steeringTorqueEps": as_float(
          get_path(
            car_state, "steeringTorqueEps", float("nan"))),
        "steeringPressed": as_bool(
          get_path(car_state, "steeringPressed", False)),
        "steerRatioLive": as_float(
          get_path(live, "steerRatio", float("nan"))),

        "opLongUnexpected": op_long_unexpected,
      }

      row.update(wheel_values(car_state))
      row.update(lead_values(radar))
      row.update(plan_values(plan))
      row.update(device_values(device_state))
      row.update(manager_values(manager_state))

      for prefix, cache in (("rx", rx_cache), ("tx", tx_cache)):
        row.update(decode_207(
          latest_address(cache, 0x207), prefix))
        row.update(decode_208(
          latest_address(cache, 0x208), prefix))
        row.update(decode_1ab(
          latest_address(cache, 0x1AB), prefix))
        row.update(decode_271(
          latest_address(cache, 0x271), prefix))
        row.update(decode_273(
          latest_address(cache, 0x273), prefix))
        row.update(decode_274(
          latest_address(cache, 0x274), prefix))

      summary_writer.writerow(row)
      summary_rows += 1

      previous_values.update(current_values)

      if summary_rows % 40 == 0:
        summary_file.flush()
        selected_file.flush()
        raw_file.flush()

      if loop_now - last_status >= 2.0:
        print(
          "%6.1fs phase=%-18s remain=%4.1f "
          "speed=%5.1f cruise=%s rx271=%-16s mag=%s "
          "raw=%d selected=%d loop=%5.1fms" % (
            t,
            phase,
            phase_remaining,
            row["vEgoKph"],
            "on" if cruise_enabled else "off",
            rx271_state,
            row.get("rx271Magnitude", ""),
            raw_written,
            selected_written,
            loop_dt_ms,
          )
        )
        last_status = loop_now

      next_sample += 1.0 / RATE_HZ
      delay = next_sample - time.monotonic()

      if delay > 0:
        time.sleep(delay)
      else:
        next_sample = time.monotonic()

  # Close an active event cleanly on stop.
  if event_active:
    events_writer.writerow({
      "eventId": event_id,
      "eventStartT": event_start_t,
      "eventEndT": time.monotonic() - start_seconds,
      "eventReasons": "|".join(event_reasons),
      "rawFramesAtStart": event_raw_start,
      "rawFramesAtEnd": raw_written,
    })

  print("")
  print("Logger stopped cleanly.")
  print("Summary rows:", summary_rows)
  print("Selected CAN frames:", selected_written)
  print("Raw event frames:", raw_written)
  print("Summary:", summary_path)
  print("Selected CAN:", selected_path)
  print("Raw events:", raw_path)
  print("Events:", events_path)


if __name__ == "__main__":
  main()
