def open_socket(name):
  try:
    return messaging.sub_sock(name, conflate=False)
  except TypeError:
    return messaging.sub_sock(name)


def recv_one(sock):
  try:
    return messaging.recv_one_or_none(sock)
  except Exception:
    return None


def to_bytes(value):
  try:
    return bytes(value)
  except Exception:
    try:
      return bytes(bytearray(ord(x) for x in value))
    except Exception:
      return b""


def signed_byte(value):
  return value - 256 if value >= 128 else value


def bit(data, byte_index, bit_index):
  try:
    return (data[byte_index] >> bit_index) & 1
  except Exception:
    return 0


def dnga_checksum(address, data_without_checksum):
  return (address + 8 + 1 + 2 + sum(data_without_checksum)) & 0xFF


def message_log_ns(msg, fallback_ns):
  try:
    value = int(msg.logMonoTime)
    return value if value > 0 else fallback_ns
  except Exception:
    return fallback_ns


def drain_socket(sock, field_name, direction, start_ns, cache):
  output = []

  while True:
    msg = recv_one(sock)
    if msg is None:
      break

    recv_ns = time.monotonic_ns()
    log_ns = message_log_ns(msg, recv_ns)

    try:
      frames = getattr(msg, field_name)
    except Exception:
      continue

    wall = datetime.now().isoformat()
    original_t = (log_ns - start_ns) / 1e9
    received_t = (recv_ns - start_ns) / 1e9

    for frame in frames:
      try:
        address = int(frame.address)
        bus = int(frame.src)
        raw = to_bytes(frame.dat)
      except Exception:
        continue

      item = {
        "t": original_t,
        "tReceived": received_t,
        "logMonoTimeNs": log_ns,
        "wallTime": wall,
        "direction": direction,
        "address": address,
        "addressHex": "0x%03X" % address,
        "name": WATCH_IDS.get(address, ""),
        "bus": bus,
        "dlc": len(raw),
        "data": raw.hex().upper(),
        "raw": raw,
      }

      output.append(item)
      cache[(address, bus)] = item

  return output


def latest_address(cache, address):
  newest = None
  for (candidate, bus), item in cache.items():
    if candidate != address:
      continue
    if newest is None or item["logMonoTimeNs"] > newest["logMonoTimeNs"]:
      newest = item
  return newest


def raw_meta(item, stem):
  if item is None:
    return {
      stem + "Raw": "",
      stem + "Bus": "",
      stem + "AgeMs": "",
    }

  return {
    stem + "Raw": item["data"],
    stem + "Bus": item["bus"],
    stem + "AgeMs":
      (time.monotonic_ns() - item["logMonoTimeNs"]) / 1e6,
  }


def decode_207(item, prefix):
  stem = prefix + "207"
  output = raw_meta(item, stem)
  output.update({
    stem + "GasPressedBit": "",
    stem + "ResPlus": "",
    stem + "SetMinus": "",
    stem + "Cancel": "",
  })

  if item is None:
    return output

  data = item["raw"]
  output.update({
    stem + "GasPressedBit": bit(data, 1, 4),
    stem + "ResPlus": bit(data, 0, 6),
    stem + "SetMinus": bit(data, 0, 5),
    stem + "Cancel": bit(data, 0, 4),
  })
  return output


def decode_208(item, prefix):
  stem = prefix + "208"
  output = raw_meta(item, stem)
  output.update({
    stem + "AccRdy": "",
    stem + "ResPlus": "",
    stem + "SetMinus": "",
    stem + "Cancel": "",
    stem + "PedalDepressed": "",
    stem + "NewSignal1": "",
    stem + "NewSignal2": "",
    stem + "Counter": "",
  })

  if item is None:
    return output

  data = item["raw"]
  output.update({
    stem + "AccRdy": bit(data, 1, 1),
    stem + "ResPlus": bit(data, 0, 6),
    stem + "SetMinus": bit(data, 0, 5),
    stem + "Cancel": bit(data, 0, 4),
    stem + "PedalDepressed": bit(data, 1, 4),
    stem + "NewSignal1": bit(data, 1, 3),
    stem + "NewSignal2": bit(data, 3, 7),
    stem + "Counter":
      (data[3] & 0x0F) if len(data) > 3 else "",
  })
  return output


def decode_1ab(item, prefix):
  stem = prefix + "1AB"
  output = raw_meta(item, stem)
  output.update({
    stem + "PowerButton": "",
    stem + "LkcButton": "",
    stem + "DistanceButton": "",
  })

  if item is None:
    return output

  data = item["raw"]
  output.update({
    stem + "PowerButton": bit(data, 3, 4),
    stem + "LkcButton": bit(data, 4, 3),
    stem + "DistanceButton": bit(data, 0, 7),
  })
  return output


def decode_271(item, prefix):
  stem = prefix + "271"
  output = raw_meta(item, stem)
  output.update({
    stem + "State": "",
    stem + "StateName": "",
    stem + "Active": False,
    stem + "PumpRaw": "",
    stem + "Pump": "",
    stem + "Magnitude": "",
    stem + "Counter": "",
    stem + "ChecksumValid": "",
  })

  if item is None:
    return output

  try:
    data = item["raw"]
    if len(data) != 8:
      return output

    state = int(data[1])
    names = {
      0x00: "disabled",
      0x01: "ready_no_brake",
      0x20: "possible_brake_20",
      0x21: "active_brake",
      0x30: "possible_hold_30",
      0x31: "possible_hold_31",
    }

    output.update({
      stem + "State": state,
      stem + "StateName":
        names.get(state, "unknown_%02X" % state),
      stem + "Active": state in (0x20, 0x21, 0x30, 0x31),
      stem + "PumpRaw": signed_byte(int(data[3])),
      stem + "Pump": signed_byte(int(data[3])) / 10.0,
      stem + "Magnitude":
        (int(data[4]) << 8) | int(data[5]),
      stem + "Counter":
        (int(data[6]) >> 2) & 0x07,
      stem + "ChecksumValid":
        int(data[7]) == dnga_checksum(0x271, list(data[:-1])),
    })
  except Exception:
    pass

  return output


def decode_273(item, prefix):
  stem = prefix + "273"
  output = raw_meta(item, stem)
  output.update({
    stem + "SetSpeedKph": "",
    stem + "FollowDistance": "",
    stem + "Lead": "",
    stem + "AccCmdKph": "",
    stem + "IsAccel": "",
    stem + "IsDecel": "",
    stem + "SetMe12": "",
    stem + "Set1WhenEngage": "",
    stem + "Set0WhenEngage": "",
    stem + "SetMe1": "",
    stem + "Unknown1": "",
    stem + "Unknown2": "",
    stem + "ChecksumValid": "",
  })

  if item is None:
    return output

  try:
    data = item["raw"]
    if len(data) != 8:
      return output

    output.update({
      stem + "SetSpeedKph": int(data[0]),
      stem + "FollowDistance": int(data[1]) & 0x03,
      stem + "Lead": bit(data, 1, 3),
      stem + "AccCmdKph":
        ((int(data[2]) << 8) | int(data[3])) * 0.01,
      stem + "IsAccel": bit(data, 4, 6),
      stem + "IsDecel": bit(data, 4, 5),
      stem + "SetMe12": bit(data, 1, 1),
      stem + "Set1WhenEngage": bit(data, 1, 5),
      stem + "Set0WhenEngage": bit(data, 5, 0),
      stem + "SetMe1": bit(data, 6, 6),
      stem + "Unknown1": bit(data, 5, 7),
      stem + "Unknown2": bit(data, 4, 1),
      stem + "ChecksumValid":
        int(data[7]) == dnga_checksum(0x273, list(data[:-1])),
    })
  except Exception:
    pass

  return output


def decode_274(item, prefix):
  stem = prefix + "274"
  output = raw_meta(item, stem)
  output.update({
    stem + "LkasSet": "",
    stem + "LkasEngaged": "",
    stem + "HoldWarning": "",
    stem + "LdaOff": "",
    stem + "LdaAlert": "",
    stem + "AebAlarm": "",
    stem + "AebBrake": "",
    stem + "FrontDepart": "",
  })

  if item is None:
    return output

  data = item["raw"]
  output.update({
    stem + "LkasSet": bit(data, 2, 3),
    stem + "LkasEngaged": bit(data, 3, 6),
    stem + "HoldWarning": bit(data, 2, 2),
    stem + "LdaOff": bit(data, 1, 5),
    stem + "LdaAlert": bit(data, 1, 6),
    stem + "AebAlarm": bit(data, 1, 0),
    stem + "AebBrake": bit(data, 2, 7),
    stem + "FrontDepart": bit(data, 1, 1),
  })
  return output


def startup_phase(t):
  if t < 5.0:
    return "BASELINE"
  if t < 15.0:
    return "ACC_MAIN"
  if t < 25.0:
    return "SET_MINUS"
  if t < 35.0:
    return "RES_PLUS"
  if t < 45.0:
    return "CANCEL"
  if t < 55.0:
    return "DISTANCE"
  if t < 65.0:
    return "LKA"
  if t < 75.0:
    return "NO_BUTTON_BASELINE"
  if t < 90.0:
    return "PREPARE_TO_DRIVE"
  return "DRIVE"


def startup_phase_remaining(t):
  boundaries = [5.0, 15.0, 25.0, 35.0, 45.0,
                55.0, 65.0, 75.0, 90.0]
  for boundary in boundaries:
    if t < boundary:
      return boundary - t
  return 0.0


