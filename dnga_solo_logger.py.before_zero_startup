def get_path(obj, path, default=None):
  try:
    value = obj
    for part in path.split("."):
      value = getattr(value, part)
    return value
  except Exception:
    return default


def first_value(obj, paths, default=None):
  for path in paths:
    value = get_path(obj, path, None)
    if value is not None:
      return value
  return default


